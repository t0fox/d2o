# Конфигурация d2k. Файл принадлежит владельцу: установщик его не
# перезаписывает при обновлении.
SCHEMA=1
MODE=apply
PANEL_LISTEN=127.0.0.1:8090
STATE_DIR=/opt/d2k/state
QUEUE_NUM=2000
CONTROL_SOCKET=/opt/d2k/run/d2kd.sock
DECOY_SNI=disk.rzd.ru
# Keenetic: первые 30 пакетов каждого потока идут мимо аппаратного ускорителя
# (-j PPE с connskip), иначе d2k не видит ответов. 0 — не ставить.
D2K_PPE_DEOFFLOAD=1
# TCP-порты разгрузки; по умолчанию — PORTS очереди (0:65535). UDP — 443 и
# голосовые VOICE_PORTS (D2K_PPE_UDP_PORTS). Сузить, если окно в 30 пакетов
# на каждый поток слишком дорого процессору:
# D2K_PPE_TCP_PORTS=80,443
MARK=0x2d
TG_ENABLED=1
TG_MODE=local
# Секрет локального MTProto-прокси для ручного подключения по tg://proxy
# (32 hex-символа). Несколько секретов — через запятую. Установщик создаёт
# первый автоматически, если строки нет.
# TG_PROXY_SECRET=
# TG_PORT=1443
# FakeTLS-камуфляж локального listener (необязательно). Если задан, панель
# выдаёт secret с префиксом ee; прозрачный режим на этом listener отключается.
# TG_LISTEN_FAKETLS_DOMAIN=cdn.example.com
