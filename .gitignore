*.tsv
*.summary.json
*.ct-*.txt
docs/field/raw/
spike/nfqview-c/nfqview-c-linux-*
spike/bench/results/
# builds/ — каталог сборки, а не канал установки. Бинарники на роутер идут
# только подписанным выпуском (scripts/install.sh и files/d2k-update.sh берут
# один и тот же архив), поэтому d2kd, d2kc и d2kpanel здесь больше не
# коммитятся: держать их в git значило держать комплект, который обновляет
# человек, — 13.10.2026 ручная установка так и поставила движок от 12.10.
#
# Исключение одно — d2ktg. Его собирают со статическим OpenSSL (минуты на
# арку), а scripts/lab-install.sh нужен готовый бинарник, чтобы пройти
# установку целиком в контейнере. Это испытательный образец, не артефакт
# выпуска: выпуск собирает свой d2ktg сам.
builds/*
!builds/d2ktg-linux-*
/build/
/telegram/build/
/panel/d2kpanel
/panel/test_server
/panel/test_server_san
/panel/test_config_values
/panel/test_header_deadline
/panel/test_response_deadline
/panel/test_status_cache

# Планы реализации — локальные, как и в z2k: публикуется спека, а не план.
docs/superpowers/
# Датапат: белый список вместо чёрного.
#
# Чёрный список я переписывал трижды и трижды же мимо него уезжали бинарники —
# сперва test_session и соседи, потом ctlprobe. Каждый раз правило покрывало
# ровно то, о чём я помнил в ту минуту. Здесь наоборот: по умолчанию не идёт
# ничего, а исходники перечислены явно. Забытый исходник заметит CI (сборка
# развалится), забытый бинарник не заметит никто.
datapath/*
!datapath/*.c
!datapath/*.h
!datapath/Makefile
!datapath/test_raw_cap.sh
!datapath/include/
!datapath/testdata/

# Ядро: тот же белый список и по той же причине.
core/*
!core/*.c
!core/*.h
!core/Makefile
!core/include/
# Профили холодного старта ОБЯЗАНЫ попасть в репозиторий: без них на другой
# машине холодный старт не соберётся (core/hello_profiles.inc, который из
# .hex делает core/Makefile, — вывод сборки, в git не идёт, и без исходных
# .hex его неоткуда взять). core/* выше молчаливо ИСКЛЮЧИЛ бы всю новую
# директорию profiles/ — строка ниже её ДОБАВЛЯЕТ в белый список, тем же
# приёмом, что !core/include/ на предыдущей строке. core/profiles/*.hex —
# снятые данные, а не код (см. core/hello.c), и правятся руками только там.
!core/profiles/
# Эталон теста каталога (задача 1) — снимок настоящего catalog.json с
# роутера, а не выдуманные данные (core/test_catalog.c про это в шапке).
# core/* выше молчаливо ИСКЛЮЧИЛ бы и эту директорию — тем же приёмом, что
# !core/profiles/ строкой выше, возвращаем её в белый список. Без этой
# строки тест зелёный только там, где его писали: на другой машине
# testdata/catalog-real.json просто не доедет до репозитория, и
# d2k_catalog_load упадёт на отсутствующем файле, а не на разборе.
!core/testdata/

# detect/ — тот же белый список и по той же причине, что у датапата выше:
# забытый исходник заметит сборка, забытый бинарник не заметит никто.
detect/*
!detect/*.c
!detect/Makefile
!detect/include/
!detect/tests/

# Локальная навигация C-кода; конфигурация и пути зависят от машины.
/compile_commands.json
/.serena/
/.cache/clangd/

# Local update release/operator outputs (keys must stay outside the checkout).
/builds/update-*/
/builds/tests/
/builds/provenance-*.json
/builds/gates-*.json
/update-release/

# Python bytecode from release tooling; a release checkout must stay clean.
__pycache__/
